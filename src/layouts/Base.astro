---
/**
 * Document skeleton only: <html>, meta, favicon, the shared reset.
 * NO VISUAL IDENTITY LIVES HERE. The portfolio and Chronica are visually
 * separate on purpose — see CLAUDE.md. Anything with a look belongs in the
 * layout below this one.
 */
import '../styles/reset.css';
import { localeUrl, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Body class the area's stylesheet hangs off: "portfolio" | "chronica". */
  bodyClass: string;
  favicon?: string;
  /**
   * Path (without locale prefix) that exists in BOTH locales, e.g. "chronica".
   * Omit on English-only routes — the legal pages advertise no Spanish
   * counterpart, because there isn't one.
   */
  translatedPath?: string;
}

const {
  title,
  description,
  lang,
  bodyClass,
  favicon = '/favicon.svg',
  translatedPath,
} = Astro.props;

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href.replace(/(.)\/$/, '$1');
const canonical = abs(Astro.url.pathname);

const alternates =
  translatedPath === undefined
    ? []
    : [
        { hreflang: 'en', href: abs(localeUrl('en', translatedPath)) },
        { hreflang: 'es', href: abs(localeUrl('es', translatedPath)) },
        { hreflang: 'x-default', href: abs(localeUrl('en', translatedPath)) },
      ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
