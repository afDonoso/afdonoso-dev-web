---
/** A missing asset, drawn as a striped slot. Swapping in the real image later
 *  should be a one-element change. */
interface Props {
  /** Extra modifier class: c-slot--icon | c-slot--screen | c-slot--badge */
  variant: string;
  label: string;
  /** Caption lines, e.g. ["screenshot", "session running", "390 × 844"] */
  caption: string[];
  fleuron?: boolean;
}

const { variant, label, caption, fleuron = false } = Astro.props;
---

<div class={`c-slot ${variant}`} role="img" aria-label={label}>
  {fleuron && <span class="c-orn" aria-hidden="true">❦</span>}
  <span class="c-slot__caption">
    {caption.map((line, i) => (
      <>{i > 0 && <br />}{line}</>
    ))}
  </span>
</div>
